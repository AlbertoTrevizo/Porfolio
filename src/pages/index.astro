---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import SocialPill from '../components/SocialPill.astro'
import Experience from '../components/Experience.astro'
import SectionContainer from '../components/SectionContainer.astro'
import WorksGallery from '../components/WorksGallery.astro'
import StackList from '../components/StackList.astro'
import SentientSphere from '../components/SentientSphere.astro'
import LinkedInIcon from '../components/icons/LinkedIn.astro'
import GithubIcon from '../components/icons/Github.astro'
import MailIcon from '../components/icons/Mail.astro'
---

<Layout 
	title="Alberto Trevizo"
	description="Contrata a Alberto para crear tu aplicacion o automatizacion."
>
	<main class="px-4">
		<section id="about" class="relative w-full min-h-[85vh] flex items-center overflow-hidden -mx-4">
			<SentientSphere />
			<div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-[#050505]"></div>

			<div class="relative z-10 flex h-full min-h-[85vh] w-full flex-col justify-between px-8 py-16 md:px-20 md:py-20 lg:px-28">
				<h1 class="text-white font-bold text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[0.95]">
					Alberto<br/>
					<span class="font-serif font-normal italic">Trevizo</span>
				</h1>

				<div class="self-end max-w-xl text-right">
					<h2 class="text-white font-bold text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[0.95]" data-role-heading>
						Software<br/>
						<span class="font-serif font-normal italic">Engineer</span>
					</h2>
					<p class="mt-6 text-gray-300 text-base md:text-lg text-wrap">
						I build things for the web, experimenting with<br/>
						AI, and occasionally disappear into a rave.
					</p>
				</div>
			</div>
		</section>

		<section id="experience" class="relative w-full py-14 -mx-4 px-4 md:px-12">
			<Experience/>
		</section>

		<section id="projects" class="relative z-20 w-full py-14">
			<div class="mx-auto w-full max-w-4xl">
				<WorksGallery />
			</div>
		</section>

		<SectionContainer id="stack" class="mt-24 md:mt-[10.5rem] mb-10 md:mb-12">
			<StackList />
		</SectionContainer>
	</main>
</Layout>