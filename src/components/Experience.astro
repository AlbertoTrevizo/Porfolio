---
import ExperienceItem from "./ExperienceItem.astro"
import Vinyl from "./Vinyl.astro"

const EXPERIENCIE = [
  {
    title: "Generalist & QA",
    date: "February 2026 - Present [Remote]",
    descriptions: [
      "Designed and wrote tasks for computer-use AI training environments, ranging from single-application workflows to complex, multi-application scenarios requiring cross-app data usage and decision-making.",
      "Performed QA on task prompts, ensuring clarity, feasibility within the target environment, alignment between expected and actual outcomes, and adherence to established guidelines.",
      "Conducted session reviews by evaluating model-generated trajectories, determining task validity based on model performance and verifier accuracy (e.g., identifying overly narrow or overly broad verifiers).",
    ],
    company: "Fleet Fellow",
  },
  {
    title: "AI Model Trainer",
    date: "June 2024 - February 2026 [Remote]",
    descriptions: [
      "Designed and implemented training tasks for AI models, analyzing and correcting model responses and reasoning to identify and resolve errors, inconsistencies, and edge cases.",
      "Followed detailed annotation guidelines and contributed feedback to improve task design and data quality.",
      "Worked independently in a remote environment while meeting strict accuracy and productivity targets.",
    ],
    company: "Outlier",
  },
  {
    title: "Web Developer",
    date: "June 2022 - june 2023 [Remote]",
    descriptions: [
      "Worked closely with teams in the United States and India to plan and organize the execution of a project.",
      "Configuration of the ServiceNow platform's modules to ensure that websites operate properly in a team larger than eight people.",
      "Daily meetings using the scrum technique to report advancements.",
      "Automating the creation and configuration of an instance in GCP in preparation for migrating an application to the cloud through a terraform script."
    ],
    company: "Concentrix Catalyst",
  },
  {
    title: "Web Developer",
    date: "December 2019 - June 2022 [Remote]",
    descriptions: [
      "As a tech lead of a team of three people, developing automated tests with Java and Selenium to ensure the proper operation of websites.",
      "In charge of providing maintenance and fixes for a Perl-based server.",
      "Repairing errors or updating mobile applications for libraries.",
    ],
    company: "Prokarma (now Concentrix Catalyst)",
  },
  {
    title: "Node Developer Jr",
    date: "February 2019 - December 2019",
    descriptions: [
      "Development and maintenance of mobile applications with unity and server-side using NodeJS.",
      "Creation of new features, tests and fixes for the server as well as the application.",
      "Offering fixes for current issues or suggestions for new features.",
      "Reporting newly found bugs.",
    ],
    company: "GammaPartners (now Concentrix Catalyst)",
  },
  {
    title: "Intern",
    date: "November 2017 - February 2019",
    descriptions: [
      "Administration of the web pages for the UACH.",
      "Creation and maintenance of features to the Content Management System made with Ruby on Rails.",
      "Collaboration in the development of a dynamic template for future projects.",
    ],
    company: "Universidad Autónoma de Chihuahua (UACH)",
  },
]
---

<div class="experience-pin relative h-[400vh]" data-experience-pin>
	<div class="experience-stage sticky top-[57px] flex h-[calc(100vh-57px)] w-full items-stretch overflow-hidden" data-experience-stage>
		<div class="flex h-full flex-1 items-center justify-center pl-[9%]">
			<div class="playlist relative z-10 h-[26rem] w-full max-w-xl md:h-[30rem]" data-playlist>
				<ol class="relative h-full">
					{EXPERIENCIE.map((experience, i) => (
						<ExperienceItem {...experience} index={i + 1} />
					))}
				</ol>
			</div>
		</div>

		<div class="relative flex h-full flex-1 items-center justify-end pr-[16%]">
			<Vinyl class="pointer-events-none mt-[calc(-10%+200px)] h-[45vh] w-[45vh] sm:h-[54vh] sm:w-[54vh] md:h-[66vh] md:w-[66vh] lg:h-[75vh] lg:w-[75vh]" />
		</div>
	</div>
</div>

<script>
	const pin = document.querySelector<HTMLElement>('[data-experience-pin]');
	const vinylReveal = document.querySelector<HTMLElement>('[data-vinyl-reveal]');
	const needleArm = document.querySelector<HTMLElement>('[data-needle-arm]');
	const playlist = document.querySelector<HTMLElement>('[data-playlist]');
	const tracks = Array.from(document.querySelectorAll<HTMLElement>('[data-track]'));
	const roleHeading = document.querySelector<HTMLElement>('[data-role-heading]');
	const projects = document.getElementById('projects');
	const stage = document.querySelector<HTMLElement>('[data-experience-stage]');

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (pin && vinylReveal && playlist && !reduceMotion) {
		let ticking = false;
		let spacing = window.innerWidth < 768 ? 165 : 235;

		// The scroll range starts as soon as the "Software" heading touches the header
		// line (instead of waiting for the pinned section itself to reach the top), so the
		// vinyl is already appearing while the hero is still scrolling away — no black gap.
		const HEADER_HEIGHT = 57;
		let startY = 0;
		let endY = 1;
		let projectsDrop = 0;
		let projectsRestY = 0;
		let vinylBottomRest = 0;
		let remPx = 16;

		// Timeline (as a fraction of the pinned scroll range):
		// 0 -> VINYL_SETTLE      vinyl's own reveal animation (opacity/slide) finishes
		// VINYL_SETTLE -> ...    vinyl starts spinning (Vinyl.astro reads data-spin, set in render())
		// ... -> PLAYLIST_IN_START   the stage itself is still scrolling into place (not yet
		//                            sticky), so the vinyl keeps visually moving up the screen
		//                            even though its own animation already finished; the playlist
		//                            waits for that motion to stop too, computed dynamically below
		// PLAYLIST_IN_START -> PLAYLIST_IN_END   playlist fades in, once the vinyl is fully still
		// PLAYLIST_IN_END -> PLAYLIST_OUT_START  stable window: tracks scroll through the coverflow
		// PLAYLIST_OUT_START -> PLAYLIST_OUT_END playlist fades out first, the same way it faded in
		// PLAYLIST_OUT_END -> 1                  only once the playlist is gone does the vinyl move up and disappear
		const VINYL_SETTLE = 0.045;
		const PLAYLIST_FADE_SPAN = 0.085;
		let PLAYLIST_IN_START = 0.075;
		let PLAYLIST_IN_END = 0.16;
		const PLAYLIST_OUT_START = 0.77;
		const PLAYLIST_OUT_END = 0.85;

		function computeRange() {
			if (roleHeading) {
				startY = roleHeading.getBoundingClientRect().top + window.scrollY - HEADER_HEIGHT;
			} else {
				startY = pin!.getBoundingClientRect().top + window.scrollY;
			}
			endY = pin!.getBoundingClientRect().bottom + window.scrollY - window.innerHeight;

			const pinTopDocY = pin!.getBoundingClientRect().top + window.scrollY;
			const stickyY = pinTopDocY - HEADER_HEIGHT;
			const stickyProgress = Math.min(Math.max((stickyY - startY) / Math.max(endY - startY, 1), 0), 1);

			PLAYLIST_IN_START = Math.max(VINYL_SETTLE, stickyProgress);
			PLAYLIST_IN_END = Math.min(PLAYLIST_IN_START + PLAYLIST_FADE_SPAN, PLAYLIST_OUT_START);

			// Projects rise in while the vinyl leaves. A negative margin pulls the section up so
			// that, at progress 1 (vinyl gone), it is already centered in the viewport. Until then
			// a transform (projectsDrop) keeps it just below the fold and slides it up to zero
			// over the same PLAYLIST_OUT_END -> 1 window the vinyl uses to disappear.
			if (projects) {
				projects.style.marginTop = '0px';
				projects.style.transform = 'none';
				const rect = projects.getBoundingClientRect();
				const naturalTop = rect.top + window.scrollY;
				const restY = Math.max(HEADER_HEIGHT, (HEADER_HEIGHT + window.innerHeight - rect.height) / 2);
				const lift = Math.max(naturalTop - (endY + restY), 0);
				const outStartScrollY = startY + PLAYLIST_OUT_END * (endY - startY);
				const yAtOutStart = restY + (endY - outStartScrollY);
				projectsDrop = Math.max(window.innerHeight - yAtOutStart, 0);
				projectsRestY = restY;
				projects.style.marginTop = `${-lift}px`;
			}

			// Where the visible disc's bottom edge sits (viewport px) while the stage is pinned,
			// measured with the vinyl at rest. The disc fills ~72% of the canvas height around
			// its center, so 0.9 leaves margin for the wobble; the stage clips at the viewport bottom.
			if (stage) {
				vinylReveal!.style.transform = 'none';
				const vinylRect = vinylReveal!.getBoundingClientRect();
				const stageTop = stage.getBoundingClientRect().top;
				vinylBottomRest = Math.min(
					HEADER_HEIGHT + (vinylRect.top - stageTop) + vinylRect.height * 0.9,
					window.innerHeight,
				);
				remPx = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
			}

			// Scroll range where the tracks move, read by Vinyl.astro so scratching scrolls the page.
			const listStartY = startY + PLAYLIST_IN_END * (endY - startY);
			const listEndY = startY + PLAYLIST_OUT_START * (endY - startY);
			pin!.dataset.scrollMin = String(listStartY);
			pin!.dataset.scrollMax = String(listEndY);
			pin!.dataset.trackPx = String((listEndY - listStartY) / Math.max(tracks.length - 1, 1));
		}
		computeRange();

		function render() {
			ticking = false;

			const progress = Math.min(Math.max((window.scrollY - startY) / Math.max(endY - startY, 1), 0), 1);
			pin!.dataset.spin = String(Math.max(progress - VINYL_SETTLE, 0)); // read by Vinyl.astro

			const exitT = Math.min(Math.max((progress - PLAYLIST_OUT_END) / (1 - PLAYLIST_OUT_END), 0), 1);
			// Ease-out on the extra rise: its speed decays to zero exactly when the widget reaches
			// the center, so from there on it only moves with the regular scroll (no sudden slowdown).
			const remainingDrop = (1 - exitT) * (1 - exitT) * projectsDrop;

			let offsetRem = 0;
			let pushPx = 0;
			let opacity = 1;
			if (progress < VINYL_SETTLE) {
				const t = progress / VINYL_SETTLE;
				offsetRem = (1 - t) * 8;
				opacity = t;
			} else if (progress > PLAYLIST_OUT_END) {
				offsetRem = -exitT * 8;
				opacity = 1 - exitT;

				// The projects widget pushes the vinyl up: its bottom edge never dips below the
				// widget's top edge, so the two never overlap while the vinyl fades out.
				if (projects) {
					const widgetTop = projectsRestY + Math.max(endY - window.scrollY, 0) + remainingDrop;
					const vinylBottom = vinylBottomRest + offsetRem * remPx;
					pushPx = Math.max(vinylBottom - widgetTop, 0);
				}
			}
			vinylReveal!.style.transform = `translateY(calc(${offsetRem}rem - ${pushPx}px))`;
			vinylReveal!.style.opacity = String(Math.min(Math.max(opacity, 0), 1));

			if (projects) {
				projects.style.transform = exitT >= 1 ? 'none' : `translateY(${remainingDrop}px)`;
			}

			if (needleArm) {
				needleArm.style.transform = `rotate(${42 - progress * 8}deg)`;
			}

			let playlistOpacity = 0;
			if (progress >= PLAYLIST_IN_START && progress < PLAYLIST_IN_END) {
				playlistOpacity = (progress - PLAYLIST_IN_START) / (PLAYLIST_IN_END - PLAYLIST_IN_START);
			} else if (progress >= PLAYLIST_IN_END && progress < PLAYLIST_OUT_START) {
				playlistOpacity = 1;
			} else if (progress >= PLAYLIST_OUT_START && progress < PLAYLIST_OUT_END) {
				playlistOpacity = 1 - (progress - PLAYLIST_OUT_START) / (PLAYLIST_OUT_END - PLAYLIST_OUT_START);
			}
			playlistOpacity = Math.min(Math.max(playlistOpacity, 0), 1);
			playlist!.style.opacity = String(playlistOpacity);
			playlist!.style.pointerEvents = playlistOpacity > 0.5 ? 'auto' : 'none';

			const listProgress = Math.min(Math.max((progress - PLAYLIST_IN_END) / (PLAYLIST_OUT_START - PLAYLIST_IN_END), 0), 1);
			const focus = listProgress * (tracks.length - 1);

			tracks.forEach((track, i) => {
				const delta = i - focus;
				const abs = Math.min(Math.abs(delta), 2);
				const scale = 1 - abs * 0.22;
				const opacity = Math.max(0, 1 - abs * 0.65);
				track.style.transform = `translateY(calc(-50% + ${delta * spacing}px)) scale(${scale})`;
				track.style.opacity = String(opacity);
				track.style.zIndex = String(100 - Math.round(abs * 10));
			});
		}

		function schedule() {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(render);
			}
		}

		function onScroll() {
			tracks.forEach((track) => track.classList.remove('is-expanded'));
			schedule();
		}

		function onResize() {
			spacing = window.innerWidth < 768 ? 165 : 235;
			computeRange();
			onScroll();
		}

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onResize);
		window.addEventListener('load', onResize);
		render();
	} else {
		vinylReveal?.style.setProperty('transform', 'none');
		vinylReveal?.style.setProperty('opacity', '1');
		playlist?.style.setProperty('opacity', '1');
		tracks.forEach((track, i) => {
			track.style.transform = `translateY(calc(-50% + ${(i - (tracks.length - 1) / 2) * 100}px))`;
			track.style.opacity = '1';
		});
	}

	tracks.forEach((track) => {
		track.querySelector('[data-track-trigger]')?.addEventListener('click', () => {
			track.classList.toggle('is-expanded');
		});
	});
</script>
