---
interface Project {
	title: string;
	description: string;
	year: string;
	image: string;
	link: string;
}

const projects: Project[] = [
	{
		title: 'Nuecery',
		description: 'Landing page for a walnut brand, with a clean layout focused on its products.',
		year: '2025',
		image: '/projects/nuecery.webp',
		link: 'https://nuecery.netlify.app/',
	},
	{
		title: 'MyFinance',
		description: 'Personal finance app to track income, expenses and budgets in one place.',
		year: '2026',
		image: '/projects/MyFinances.webp',
		link: 'https://my-finances-f95n4zd28-albertotrevizo.vercel.app/',
	},
];
---

<div class="works-gallery relative">
	<div class="flex flex-wrap items-stretch justify-center gap-4">
		{projects.map((project) => (
			<a
				href={project.link}
				target="_blank"
				rel="noopener"
				class="gallery-card group relative h-[420px] min-w-[180px] flex-[0.8] overflow-hidden rounded-[2.5rem] md:h-[600px]"
			>
				<img
					src={project.image}
					alt={project.title}
					class="absolute inset-0 h-full w-full object-cover"
				/>

				<div class="gallery-caption absolute inset-x-4 bottom-4 rounded-3xl border border-white/10 bg-black/70 px-5 py-4 backdrop-blur-xl">
					<div class="flex items-baseline justify-between gap-4">
						<p class="text-lg font-semibold text-white">{project.title}</p>
						<p class="font-mono text-xs tracking-[0.2em] text-gray-300">{project.year}</p>
					</div>
					<p class="mt-1 text-sm leading-snug text-gray-200">{project.description}</p>
				</div>
			</a>
		))}
	</div>
</div>

<style>
	.gallery-card {
		flex: 0.8 1 0%;
		opacity: 0.9;
		cursor: none;
		transition: flex 800ms cubic-bezier(0.4, 0, 0.2, 1), opacity 800ms cubic-bezier(0.4, 0, 0.2, 1), box-shadow 800ms cubic-bezier(0.4, 0, 0.2, 1);
	}

	.gallery-card img {
		filter: grayscale(1) brightness(0.75);
		transition: filter 700ms ease;
	}

	.gallery-card.is-active {
		flex: 2 1 0%;
		opacity: 1;
		box-shadow: 0 25px 60px -15px rgba(255, 255, 255, 0.15);
	}

	.gallery-card.is-active img {
		filter: grayscale(0) brightness(1);
	}

	.gallery-caption {
		transform: translateY(2rem);
		opacity: 0;
		transition: transform 700ms ease, opacity 700ms ease;
	}

	.gallery-card.is-active .gallery-caption {
		transform: translateY(0);
		opacity: 1;
		transition-delay: 300ms;
	}
</style>

<script>
	const gallery = document.querySelector<HTMLElement>('.works-gallery')!;
	const cards = gallery.querySelectorAll<HTMLElement>('.gallery-card');

	cards.forEach((card) => {
		card.addEventListener('mouseenter', () => {
			cards.forEach((c) => c.classList.toggle('is-active', c === card));
			document.documentElement.classList.add('dot-cursor');
		});
		card.addEventListener('mouseleave', () => {
			card.classList.remove('is-active');
			document.documentElement.classList.remove('dot-cursor');
		});
	});
</script>
