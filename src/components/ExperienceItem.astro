---
interface Props {
	title: string;
	descriptions: string[];
	date: string;
	company: string;
	index: number;
}

const { title, descriptions, date, company, index } = Astro.props;
const number = String(index).padStart(2, '0');
---

<li class="track group absolute inset-x-0 top-1/2" data-track>
	<div class="border-b border-white/10 pb-6">
		<button type="button" class="flex w-full items-baseline justify-between gap-6 text-left" data-track-trigger>
			<span class="flex items-baseline gap-4">
				<span class="font-mono text-sm text-gray-500">{number}</span>
				<span class="text-2xl font-semibold text-white md:text-3xl">{title} at {company}</span>
			</span>
			<span class="track-toggle shrink-0 font-mono text-xl text-gray-500">+</span>
		</button>

		<p class="mt-1 pl-9 text-sm text-gray-400">{date}</p>

		<div class="track-panel">
			<ul class="overflow-hidden pl-9">
				{descriptions.map((description) => (
					<li class="ml-4 mt-4 list-disc text-pretty text-sm text-gray-300">{description}</li>
				))}
			</ul>
		</div>
	</div>
</li>

<style>
	.track {
		will-change: transform, opacity;
	}

	.track-panel {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 500ms ease;
	}

	.track.is-expanded .track-panel {
		grid-template-rows: 1fr;
	}

	.track-toggle {
		transition: transform 300ms ease;
	}

	.track.is-expanded .track-toggle {
		transform: rotate(45deg);
	}
</style>
