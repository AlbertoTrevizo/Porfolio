---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['relative', className]} data-vinyl-outer>
	<div class="vinyl-reveal h-full w-full" data-vinyl-reveal>
		<canvas class="h-full w-full" data-vinyl-canvas></canvas>

		<div class="vinyl-needle" data-needle>
			<span class="needle-base"></span>
			<span class="needle-arm" data-needle-arm>
				<span class="needle-head"></span>
			</span>
		</div>
	</div>
</div>

<script>
	import * as THREE from 'three';

	const canvas = document.querySelector<HTMLCanvasElement>('[data-vinyl-canvas]');
	const container = canvas?.parentElement;
	const pin = document.querySelector<HTMLElement>('[data-experience-pin]');
	const roleHeading = document.querySelector<HTMLElement>('[data-role-heading]');
	const HEADER_HEIGHT = 57;

	let startY = 0;
	let endY = 1;

	function computeRange() {
		if (!pin) return;
		if (roleHeading) {
			startY = roleHeading.getBoundingClientRect().top + window.scrollY - HEADER_HEIGHT;
		} else {
			startY = pin.getBoundingClientRect().top + window.scrollY;
		}
		endY = pin.getBoundingClientRect().bottom + window.scrollY - window.innerHeight;
	}
	computeRange();
	window.addEventListener('resize', computeRange);

	if (canvas && container) {
		const scene = new THREE.Scene();
		const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
		camera.position.z = 5;

		const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

		const ringCount = 48;
		const segCount = 96;
		const outerRadius = 1.5;

		const positions: number[] = [];
		const normals: number[] = [];
		const uvs: number[] = [];
		const indices: number[] = [];

		for (let ring = 0; ring <= ringCount; ring++) {
			const r = (ring / ringCount) * outerRadius;
			for (let seg = 0; seg <= segCount; seg++) {
				const theta = (seg / segCount) * Math.PI * 2;
				positions.push(r * Math.cos(theta), r * Math.sin(theta), 0);
				normals.push(0, 0, 1);
				uvs.push(seg / segCount, ring / ringCount);
			}
		}

		for (let ring = 0; ring < ringCount; ring++) {
			for (let seg = 0; seg < segCount; seg++) {
				const a = ring * (segCount + 1) + seg;
				const b = a + segCount + 1;
				const c = a + 1;
				const d = b + 1;
				indices.push(a, b, c, b, d, c);
			}
		}

		const geometry = new THREE.BufferGeometry();
		geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
		geometry.setAttribute('normal', new THREE.Float32BufferAttribute(normals, 3));
		geometry.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
		geometry.setIndex(indices);

		const material = new THREE.ShaderMaterial({
			transparent: true,
			wireframe: true,
			uniforms: {
				uTime: { value: 0 },
			},
			vertexShader: `
				uniform float uTime;
				varying vec3 vNormal;
				varying float vDisplacement;
				varying vec2 vUv;

				vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
				vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
				vec4 permute(vec4 x) { return mod289(((x * 34.0) + 1.0) * x); }
				vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }

				float snoise(vec3 v) {
					const vec2 C = vec2(1.0 / 6.0, 1.0 / 3.0);
					const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);

					vec3 i = floor(v + dot(v, C.yyy));
					vec3 x0 = v - i + dot(i, C.xxx);

					vec3 g = step(x0.yzx, x0.xyz);
					vec3 l = 1.0 - g;
					vec3 i1 = min(g.xyz, l.zxy);
					vec3 i2 = max(g.xyz, l.zxy);

					vec3 x1 = x0 - i1 + C.xxx;
					vec3 x2 = x0 - i2 + C.yyy;
					vec3 x3 = x0 - D.yyy;

					i = mod289(i);
					vec4 p = permute(permute(permute(
						i.z + vec4(0.0, i1.z, i2.z, 1.0))
						+ i.y + vec4(0.0, i1.y, i2.y, 1.0))
						+ i.x + vec4(0.0, i1.x, i2.x, 1.0));

					float n_ = 0.142857142857;
					vec3 ns = n_ * D.wyz - D.xzx;

					vec4 j = p - 49.0 * floor(p * ns.z * ns.z);

					vec4 x_ = floor(j * ns.z);
					vec4 y_ = floor(j - 7.0 * x_);

					vec4 x = x_ * ns.x + ns.yyyy;
					vec4 y = y_ * ns.x + ns.yyyy;
					vec4 h = 1.0 - abs(x) - abs(y);

					vec4 b0 = vec4(x.xy, y.xy);
					vec4 b1 = vec4(x.zw, y.zw);

					vec4 s0 = floor(b0) * 2.0 + 1.0;
					vec4 s1 = floor(b1) * 2.0 + 1.0;
					vec4 sh = -step(h, vec4(0.0));

					vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
					vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;

					vec3 p0 = vec3(a0.xy, h.x);
					vec3 p1 = vec3(a0.zw, h.y);
					vec3 p2 = vec3(a1.xy, h.z);
					vec3 p3 = vec3(a1.zw, h.w);

					vec4 norm = taylorInvSqrt(vec4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
					p0 *= norm.x;
					p1 *= norm.y;
					p2 *= norm.z;
					p3 *= norm.w;

					vec4 m = max(0.6 - vec4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
					m = m * m;
					return 42.0 * dot(m * m, vec4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
				}

				void main() {
					vNormal = normal;
					vUv = uv;
					float displacement = snoise(position * 1.5 + uTime * 0.15) * 0.15;
					vDisplacement = displacement;
					vec3 newPosition = position + normal * displacement;
					gl_Position = projectionMatrix * modelViewMatrix * vec4(newPosition, 1.0);
				}
			`,
			fragmentShader: `
				varying vec3 vNormal;
				varying float vDisplacement;
				varying vec2 vUv;

				void main() {
					float intensity = 0.3 + vDisplacement * 2.0;
					vec3 color = vec3(intensity);

					vec2 grid = fract(vUv * 20.0);
					float line = min(grid.x, grid.y);
					float onLine = 1.0 - smoothstep(0.0, 0.04, line);
					color *= mix(1.0, 0.5, onLine);

					gl_FragColor = vec4(color, 0.6);
				}
			`,
		});

		const disc = new THREE.Mesh(geometry, material);
		scene.add(disc);

		function resize() {
			const { clientWidth, clientHeight } = container!;
			if (clientWidth === 0 || clientHeight === 0) return;
			camera.aspect = clientWidth / clientHeight;
			camera.updateProjectionMatrix();
			renderer.setSize(clientWidth, clientHeight);
		}

		const resizeObserver = new ResizeObserver(resize);
		resizeObserver.observe(container);
		resize();

		const startTime = performance.now();
		let frameId: number;

		function animate() {
			frameId = requestAnimationFrame(animate);
			material.uniforms.uTime.value = (performance.now() - startTime) / 1000;

			const progress = Math.min(Math.max((window.scrollY - startY) / Math.max(endY - startY, 1), 0), 1);

			const VINYL_SETTLE = 0.045;
			const spinProgress = Math.max(progress - VINYL_SETTLE, 0);
			disc.rotation.z = THREE.MathUtils.degToRad(spinProgress * 900);

			renderer.render(scene, camera);
		}
		animate();

		document.addEventListener('astro:before-swap', () => {
			cancelAnimationFrame(frameId);
			resizeObserver.disconnect();
			renderer.dispose();
			geometry.dispose();
			material.dispose();
		});
	}
</script>

<style>
	.vinyl-reveal {
		transform: translateY(8rem);
		opacity: 0;
	}

	.vinyl-needle {
		position: absolute;
		top: -6%;
		right: 10%;
		width: 42%;
		height: 62%;
		z-index: 20;
	}

	.needle-base {
		position: absolute;
		top: 0;
		right: 2%;
		width: 13%;
		aspect-ratio: 1;
		border-radius: 9999px;
		background: #1c1c1c;
		border: 1px solid rgba(255, 255, 255, 0.18);
	}

	.needle-arm {
		position: absolute;
		top: 5%;
		right: 8%;
		width: 4%;
		height: 86%;
		border-radius: 9999px;
		background: linear-gradient(180deg, #3a3a3a, #101010);
		transform-origin: top center;
		transform: rotate(42deg);
	}

	.needle-head {
		position: absolute;
		bottom: -6%;
		left: 50%;
		width: 320%;
		height: 10%;
		transform: translateX(-50%);
		background: #e5e5e5;
		border-radius: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.vinyl-reveal {
			transform: none;
			opacity: 1;
		}
		.needle-arm {
			transform: rotate(42deg) !important;
		}
	}
</style>
