---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const grooves = Array.from({ length: 24 }, (_, i) => 68 + i * 5.5);
---

<div class:list={['relative', className]} data-vinyl-outer>
	<div class="vinyl-reveal h-full w-full" data-vinyl-reveal>
		<div class="vinyl-spin h-full w-full" data-vinyl-spin>
			<svg viewBox="0 0 400 400" class="h-full w-full drop-shadow-[0_0_80px_rgba(0,0,0,0.7)]">
				<circle cx="200" cy="200" r="198" fill="#0b0b0b" stroke="rgba(255,255,255,0.08)" stroke-width="1" />
				{grooves.map((r) => (
					<circle cx="200" cy="200" r={r} fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="1" />
				))}
				<circle cx="200" cy="200" r="58" fill="#050505" stroke="rgba(255,255,255,0.14)" stroke-width="1" />
				<circle cx="200" cy="200" r="6" fill="rgba(255,255,255,0.5)" />
			</svg>
		</div>

		<div class="vinyl-needle" data-needle>
			<span class="needle-base"></span>
			<span class="needle-arm" data-needle-arm>
				<span class="needle-head"></span>
			</span>
		</div>
	</div>
</div>

<style>
	.vinyl-reveal {
		transform: translateY(8rem);
		opacity: 0;
	}

	.vinyl-needle {
		position: absolute;
		top: -6%;
		right: 10%;
		width: 42%;
		height: 62%;
		z-index: 20;
	}

	.needle-base {
		position: absolute;
		top: 0;
		right: 2%;
		width: 13%;
		aspect-ratio: 1;
		border-radius: 9999px;
		background: #1c1c1c;
		border: 1px solid rgba(255, 255, 255, 0.18);
	}

	.needle-arm {
		position: absolute;
		top: 5%;
		right: 8%;
		width: 4%;
		height: 86%;
		border-radius: 9999px;
		background: linear-gradient(180deg, #3a3a3a, #101010);
		transform-origin: top center;
		transform: rotate(42deg);
	}

	.needle-head {
		position: absolute;
		bottom: -6%;
		left: 50%;
		width: 320%;
		height: 10%;
		transform: translateX(-50%);
		background: #e5e5e5;
		border-radius: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.vinyl-reveal {
			transform: none;
			opacity: 1;
		}
		.needle-arm {
			transform: rotate(42deg) !important;
		}
	}
</style>
